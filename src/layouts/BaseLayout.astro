---
import { SITE, languageOf, DEFAULT_LANG } from '../../site.config.mjs';
import { url } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 소셜 공유용 이미지 주소 (절대경로) */
  image?: string;
  /** 글 페이지면 'article' */
  type?: 'website' | 'article';
  publishedAt?: Date;
  /** 본문 폭을 좁게 쓸지 */
  narrow?: boolean;
  noindex?: boolean;
  /** 이 페이지 내용의 언어 ('ko' | 'en'). 글 페이지에서는 그 글의 lang 을 넘깁니다 */
  lang?: string;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedAt,
  narrow = false,
  noindex = false,
  lang: contentLang = DEFAULT_LANG,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.description}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
const ogImage = image ? new URL(image, Astro.site ?? 'https://example.com').href : undefined;
// 이 페이지의 언어. 영어 글이면 <html lang="en"> 이 되어야
// 검색엔진과 화면낭독기가 올바르게 처리합니다.
const language = languageOf(contentLang);
const lang = language.code;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL(url('/rss.xml'), Astro.site ?? 'https://example.com').href}
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={language.locale.replace('-', '_')} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {
      SITE.analytics.plausibleDomain && (
        <script
          is:inline
          defer
          data-domain={SITE.analytics.plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      )
    }

    {
      SITE.ads.enabled && SITE.ads.client && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.ads.client}`}
          crossorigin="anonymous"
        />
      )
    }

    {/* 화면 모드를 먼저 정해서 새로고침할 때 깜빡이지 않게 합니다 */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <Header />
    <main id="main">
      <div class={narrow ? 'wrap wrap--narrow' : 'wrap'}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
