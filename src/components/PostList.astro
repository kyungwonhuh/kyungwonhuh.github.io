---
import type { Post } from '../lib/posts';
import { postPath, formatDateShort } from '../lib/posts';
import { categoryOf } from '../../site.config.mjs';
import { url } from '../lib/url';

interface Props {
  posts: Post[];
  /** 카테고리 이름을 함께 보여줄지 */
  showCategory?: boolean;
}

const { posts, showCategory = true } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post) => (
      <li class="post">
        <a class="cover" href={url(postPath(post))}>
          <span class="title">
            {post.data.pinned && <span class="pin" title="고정된 글">★</span>}
            {post.data.title}
          </span>
        </a>
        {post.data.description && <p class="desc">{post.data.description}</p>}
        <p class="meta">
          <time datetime={post.data.date.toISOString()}>{formatDateShort(post.data.date)}</time>
          {showCategory && (
            <>
              <span class="dot">·</span>
              <span>{categoryOf(post.data.category).name}</span>
            </>
          )}
        </p>
      </li>
    ))
  }
</ul>

{posts.length === 0 && <p class="muted empty">아직 올라온 글이 없습니다.</p>}

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post {
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
    max-width: var(--measure);
  }

  .post:first-child { padding-top: 0; }

  .cover {
    text-decoration: none;
    display: inline-block;
  }

  .title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.5;
    transition: color 0.15s ease;
  }

  .cover:hover .title { color: var(--accent); }

  .pin {
    color: var(--accent);
    font-size: 0.8em;
    margin-right: 0.35em;
    vertical-align: 0.1em;
  }

  .desc {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .meta {
    margin: 0.55rem 0 0;
    font-size: 0.8rem;
    color: var(--text-faint);
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
  }

  .empty {
    padding-block: 2rem;
  }
</style>
