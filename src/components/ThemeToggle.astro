---
// 밝은 모드 / 어두운 모드 전환 버튼
---

<button id="theme-toggle" type="button" aria-label="밝은 모드와 어두운 모드 전환" title="화면 모드 전환">
  <svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none"
    stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.4 5.4l1.4 1.4M17.2 17.2l1.4 1.4M18.6 5.4l-1.4 1.4M6.8 17.2l-1.4 1.4" />
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none"
    stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2z" />
  </svg>
</button>

<style>
  button {
    background: none;
    border: 0;
    padding: 0.4rem;
    margin: -0.4rem;
    color: var(--text-muted);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s ease;
  }
  button:hover { color: var(--accent); }

  .moon { display: none; }
  :global(:root[data-theme='dark']) .moon { display: block; }
  :global(:root[data-theme='dark']) .sun { display: none; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .moon { display: block; }
    :global(:root:not([data-theme='light'])) .sun { display: none; }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const current = document.documentElement.dataset.theme ?? (prefersDark ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  })();
</script>
