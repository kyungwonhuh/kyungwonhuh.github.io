---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPostsPinnedFirst } from '../lib/posts';
import { SITE, CATEGORIES } from '../../site.config.mjs';
import { url } from '../lib/url';

const all = await getPostsPinnedFirst();
const posts = all.slice(0, SITE.postsOnHome);
const hasMore = all.length > posts.length;
---

<BaseLayout>
  <section class="intro">
    {SITE.intro.map((line: string) => <p>{line}</p>)}
  </section>

  <nav class="categories" aria-label="카테고리">
    {
      CATEGORIES.map((c) => (
        <a href={url(`/categories/${c.slug}`)}>
          <strong>{c.name}</strong>
          <span>{c.description}</span>
        </a>
      ))
    }
  </nav>

  <section class="recent">
    <h2 class="section-label">최근 글</h2>
    <PostList posts={posts} />
    {
      hasMore && (
        <p class="more">
          <a href={url('/archive')}>글 전체 보기 ({all.length}편) →</a>
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: var(--measure);
    font-size: 1.125rem;
    line-height: 1.85;
    letter-spacing: -0.015em;
    margin-bottom: 3rem;
  }

  .intro p {
    margin: 0;
  }

  .intro p + p {
    margin-top: 0.2em;
    color: var(--text-muted);
  }

  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 3.75rem;
  }

  .categories a {
    background: var(--bg);
    padding: 1rem 1.15rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    transition: background 0.15s ease;
  }

  .categories a:hover {
    background: var(--bg-soft);
  }

  .categories strong {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .categories span {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .more {
    margin-top: 2rem;
    font-size: 0.9rem;
  }

  .more a {
    text-decoration: none;
    color: var(--text-muted);
  }

  .more a:hover {
    color: var(--accent);
  }
</style>
